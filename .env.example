# ---- LLM (optional) ------------------------------------------------------------
# Any OpenAI-compatible /chat/completions endpoint (GLM via Hyde inference, Z.ai, OpenRouter, ...).
# Leave LLM_API_KEY empty to run fully on deterministic rules.
LLM_API_KEY=
# Base URL *without* the trailing /chat/completions, e.g. https://api.z.ai/api/paas/v4
LLM_BASE_URL=
# Model name as your provider spells it, e.g. glm-4.6
LLM_MODEL=glm-4.6
LLM_TIMEOUT=45

# ---- App -----------------------------------------------------------------------
# Pause between pipeline stages so the live view is watchable in a demo (0 = full speed)
STAGE_DELAY_MS=450

# ---- Deployment ----------------------------------------------------------------
# The app has no login. Max runs one visitor can start per hour (bounds LLM spend). 0 = unlimited.
RUNS_PER_HOUR_PER_IP=60
